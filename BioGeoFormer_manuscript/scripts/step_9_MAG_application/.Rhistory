# Create a new column 'Reads_per_Million' by normalizing 'Reads'
mutate(Reads_per_Million = (Reads / Total_Reads) * 1e6)
final_merged_data <- select(final_merged_data, Filename, Identifier, ID_part, Reads, Reads_per_Million, Protein, gene, long_pathway, cyc_pred, Reads_per_Million, superkingdom, phylum, class, order, family, genus, species, Taxonomy_whole)
complete_genes <- filter(final_merged_data, str_detect(Identifier, "partial=00"))
final_merged_data <- final_merged_data %>%
mutate(
timepoint = case_when(
str_detect(Filename, "_T0_") ~ "T0",
str_detect(Filename, "_TF_") ~ "TF",
TRUE ~ NA_character_
),
has_o2 = str_detect(Filename, "_O2_"),
oxic_status = case_when(
timepoint == "T0" ~ NA_character_,
has_o2 ~ "Oxic",
!has_o2 ~ "Anoxic",
TRUE ~ NA_character_
),
methane_exposed = case_when(
timepoint == "T0" ~ NA,
str_detect(Filename, "-CH4") ~ FALSE,
str_detect(Filename, "CH4") ~ TRUE,
TRUE ~ NA
),
depth = case_when(
has_o2 ~ "Surface",
!has_o2 ~ "Deep",
TRUE ~ NA_character_
)
) %>%
select(Filename, everything())
View(final_merged_data)
library(dplyr)
